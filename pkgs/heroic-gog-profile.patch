@@ -0,0 +1,80 @@
+import { useContext, useMemo, useRef, useState } from 'react'
+import { Avatar, MenuItem, MenuList, Popover } from '@mui/material'
+import { useNavigate } from 'react-router-dom'
+import ContextProvider from 'frontend/state/ContextProvider'
+import { gogConfigStore } from 'frontend/helpers/electronStores'
+import { gogAccountPages } from './pages'
+import './index.scss'
+
+export default function GogProfile() {
+  const { gog } = useContext(ContextProvider)
+  const navigate = useNavigate()
+  const trigger = useRef<HTMLButtonElement>(null)
+  const [anchor, setAnchor] = useState<HTMLButtonElement | null>(null)
+  const avatar = useMemo(
+    () => gogConfigStore.get_nodefault('userData.avatar'),
+    [gog.username]
+  )
+  const image = avatar?.large_2x || avatar?.small_2x || avatar?.small
+  const open = Boolean(anchor) && Boolean(gog.username)
+
+  if (!gog.username) return null
+
+  return (
+    <div className="GogProfile">
+      <button
+        ref={trigger}
+        id="gog-profile-button"
+        type="button"
+        className="GogProfile__button"
+        title={gog.username}
+        aria-label={`GOG account: ${gog.username}`}
+        aria-haspopup="menu"
+        aria-expanded={open}
+        aria-controls={open ? 'gog-profile-menu' : undefined}
+        onClick={(event) => setAnchor(event.currentTarget)}
+      >
+        <Avatar src={image} alt="">
+          {gog.username.slice(0, 1).toUpperCase()}
+        </Avatar>
+      </button>
+      <Popover
+        open={open}
+        anchorEl={anchor}
+        onClose={() => setAnchor(null)}
+        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
+        transformOrigin={{ vertical: 'bottom', horizontal: 'left' }}
+        disableRestoreFocus
+        TransitionProps={{ onExited: () => trigger.current?.focus() }}
+        slotProps={{ paper: { className: 'GogProfile__menu' } }}
+      >
+        <div className="GogProfile__header">
+          <Avatar src={image} alt="">
+            {gog.username.slice(0, 1).toUpperCase()}
+          </Avatar>
+          <div>
+            <span>Your account</span>
+            <strong>{gog.username}</strong>
+          </div>
+        </div>
+        <MenuList
+          id="gog-profile-menu"
+          aria-labelledby="gog-profile-button"
+          autoFocusItem
+        >
+          {gogAccountPages.map(({ id, label }) => (
+            <MenuItem
+              key={id}
+              onClick={() => {
+                setAnchor(null)
+                navigate(`/store/gog?account=${id}`)
+              }}
+            >
+              {label}
+            </MenuItem>
+          ))}
+        </MenuList>
+      </Popover>
+    </div>
+  )
+}
