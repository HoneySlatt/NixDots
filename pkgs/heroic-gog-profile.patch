+.Sidebar .GogProfile {
+  grid-column: 1;
+  align-self: center;
+  justify-self: center;
+  flex-shrink: 0;
+  margin-top: auto;
+  -webkit-app-region: no-drag;
+}
+
+.GogProfile__button {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  padding: 3px;
+  border: 1px solid var(--divider);
+  border-radius: 50%;
+  background: var(--background);
+  cursor: pointer;
+
+  &:hover,
+  &[aria-expanded='true'] {
+    border-color: var(--accent);
+  }
+  &:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 3px;
+  }
+}
+
+.GogProfile__button .MuiAvatar-root,
+.GogProfile__header .MuiAvatar-root {
+  width: 40px;
+  height: 40px;
+  color: var(--text-default);
+  background: var(--background-lighter);
+  font-family: var(--primary-font-family);
+}
+
+.GogProfile__menu.MuiPaper-root {
+  width: 260px;
+  max-width: calc(100vw - 96px);
+  margin-left: 12px;
+  border: 1px solid var(--divider);
+  border-radius: 12px;
+  color: var(--text-default);
+  background: var(--background);
+  background-image: none;
+  box-shadow: 0 12px 32px #0005;
+  font-family: var(--primary-font-family);
+
+  .MuiList-root {
+    padding: 6px;
+  }
+  .MuiMenuItem-root {
+    min-height: 42px;
+    padding: 10px 14px;
+    border-radius: 7px;
+    font: inherit;
+    &:hover,
+    &.Mui-focusVisible {
+      color: var(--text-default);
+      background: color-mix(in srgb, var(--accent) 14%, var(--background));
+    }
+  }
+}
+
+.GogProfile__header {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 18px;
+  border-bottom: 1px solid var(--divider);
+  > div:last-child {
+    min-width: 0;
+  }
+  span {
+    display: block;
+    color: var(--text-secondary);
+    font-size: 12px;
+  }
+  strong {
+    display: block;
+    margin-top: 4px;
+    overflow-wrap: anywhere;
+    font-size: 17px;
+  }
+}
