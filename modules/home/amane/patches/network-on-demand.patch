+/*
+ * the list costs a call per network and per saved profile every second,
+ * so it is only asked for while a window shows it
+ */
+static LIST_READ: AtomicU64 = AtomicU64::new(0);
+
+fn now() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |elapsed| elapsed.as_secs())
+}
+
+fn list_shown() -> bool {
+    now().saturating_sub(LIST_READ.load(Ordering::Relaxed)) < 3
+}
