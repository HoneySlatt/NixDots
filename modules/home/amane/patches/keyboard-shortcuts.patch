     }
 }
 
 fn to_key(event: &KeyEvent) -> Key {
+    // ctrl turns a key into a shortcut, named by the character it types without ctrl
+    if CTRL.load(Ordering::Relaxed)
+        && let Some(letter) = event.keysym.key_char().filter(|letter| !letter.is_control())
+    {
+        return Key::Control(letter.to_ascii_lowercase());
+    }
+
