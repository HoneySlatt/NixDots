+
+// answered once the compositor has handled everything sent before a show
+pub struct ShowBarrier {
+    surface: WlSurface,
+    show: u32,
+}
+
+impl Dispatch<WlCallback, ShowBarrier> for WaylandState {
+    fn event(
+        state: &mut Self,
+        _: &WlCallback,
+        event: wl_callback::Event,
+        barrier: &ShowBarrier,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let wl_callback::Event::Done { .. } = event else {
+            return;
+        };
+
+        let Some(window) = state.window(&barrier.surface) else {
+            return;
+        };
+
+        if window.shows == barrier.show {
+            window.stale_configures = false;
+        }
+    }
+}
