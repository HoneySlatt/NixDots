+use std::rc::Rc;
+
+use smithay_client_toolkit::compositor::CompositorState;
+use smithay_client_toolkit::reexports::protocols::wp::{
+    fractional_scale::v1::client::wp_fractional_scale_manager_v1::WpFractionalScaleManagerV1,
+    viewporter::client::wp_viewporter::WpViewporter,
+};
+use smithay_client_toolkit::shell::{WaylandSurface, wlr_layer::LayerShell};
 use wayland_client::{
-    Connection, Dispatch, QueueHandle,
+    Connection, Dispatch, Proxy, QueueHandle,
     protocol::wl_region::{self, WlRegion},
 };
 
 use crate::LayerWindow;
+use crate::graphics::Gpu;
 
 use super::{
     WaylandState,
     layer::{self, Settings},
+    scale,
     surface::{Content, OpenWindow, Role},
 };
 
+// what a hidden layer window needs to take a new surface, see renew_surface
+pub struct Renew {
+    pub compositor: Rc<CompositorState>,
+    pub layer_shell: Rc<LayerShell>,
+    pub connection: Connection,
+    pub fractional_scale: Option<WpFractionalScaleManagerV1>,
+    pub viewporter: Option<WpViewporter>,
+}
+
 impl OpenWindow {
     // settings changed by input or services reach the compositor before anything is drawn
     pub fn update_surface(&mut self, content: &Content) {
@@ -101,6 +120,57 @@ impl OpenWindow {
         self.frame_requested = false;
 
         self.gpu.release();
+
+        self.renew_surface();
+    }
+
+    /*
+     * wlroots compositors like mango drop the configures still on their way when a layer
+     * surface unmaps, and the toolkit acks each configure it gets, so acking one of those
+     * afterwards is a protocol error that ends the shell; on a new surface they reach the
+     * old one, which is gone, and nobody acks them. it is never committed while hidden,
+     * so showing it again makes its first commit like a window that starts hidden
+     */
+    fn renew_surface(&mut self) {
+        let Role::Layer { settings, .. } = &self.role else {
+            return;
+        };
+
+        let settings = *settings;
+
+        let surface = self.renew.compositor.create_surface(&self.qh);
+
+        let layer_surface = layer::create(
+            &self.renew.layer_shell,
+            surface,
+            self.output.as_ref(),
+            &self.qh,
+            &settings,
+        );
+
+        let wl_surface = layer_surface.wl_surface();
+
+        // the gpu draws straight into the surface, so it gets libwayland's own pointers
+        let display = self.renew.connection.backend().display_ptr().cast();
+        let gpu = Gpu::new(display, wl_surface.id().as_ptr().cast());
+
+        let fractional = scale::fractional_for(
+            self.renew.fractional_scale.as_ref(),
+            self.renew.viewporter.as_ref(),
+            wl_surface,
+            &self.qh,
+        );
+
+        // in the order they have to go: the gpu, then the fractional scale, then the surface
+        self.gpu = gpu;
+        self.fractional = fractional;
+        self.role = Role::Layer {
+            surface: layer_surface,
+            settings,
+        };
+
+        // a new surface takes the pointer everywhere until a region is sent again
+        self.input_region = None;
     }
 }
 
