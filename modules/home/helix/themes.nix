  mkTheme = _name: pal: {
    "ui.background" = { };
    "ui.background.separator" = { fg = pal.bg1; };
    "ui.cursor" = { modifiers = [ "reversed" ]; };
    "ui.cursor.insert" = { modifiers = [ "underlined" ]; };
    "ui.cursor.select" = { modifiers = [ "reversed" ]; };
    "ui.cursor.match" = { fg = pal.yellow; modifiers = [ "underlined" ]; };
    "ui.cursor.primary" = { modifiers = [ "reversed" ]; };
