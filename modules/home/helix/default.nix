{ lib, pkgs, ... }:

let
  helixWrapped = pkgs.symlinkJoin {
    name = "helix-wrapped";
    paths = [
      (pkgs.writeShellScriptBin "hx" ''
        if [ $# -eq 0 ]; then
          (sleep 0.2 && ${pkgs.wtype}/bin/wtype -k space -k f) &
        fi
        exec ${pkgs.helix}/bin/hx "$@"
      '')
      pkgs.helix
    ];
  };
in
{
  imports = [
    ./settings.nix
    ./languages.nix
  ];

  programs.helix = {
    enable = true;
    package = helixWrapped;
    # Generated by switch-theme.sh (themes/apps/helix.sh)
    settings.theme = "switch-theme";
  };

  # Generate the theme of the current palette once the config is linked
  home.activation.helixTheme = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    themes="$HOME/.config/amane/themes"
    theme_file="$HOME/.config/amane/.current-theme"
    if [ -f "$theme_file" ] && [ -f "$themes/themes.conf" ]; then
      (
        declare -A C
        source "$themes/themes.conf"
        load_palette "$(tr -d '[:space:]' < "$theme_file")" || exit 0
        source "$themes/apps/helix.sh"
        switch_helix
      )
    fi
  '';
}
